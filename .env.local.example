# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Chaves marcadas "só server" não podem ter o prefixo NEXT_PUBLIC_.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # só server

# Gemini (IA de voz)
GEMINI_API_KEY=                       # só server

# Stripe
STRIPE_SECRET_KEY=                    # só server
STRIPE_WEBHOOK_SECRET=                # só server
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (e-mails)
RESEND_API_KEY=                       # só server

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # só server
